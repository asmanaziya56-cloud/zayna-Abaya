# ==============================================================================
# ZAYNA ABAYA PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT place real secrets in this file. Copy to .env for local development only.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB Atlas in Production, local in Dev)
MONGODB_URI=

# Authentication Secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key (64-character hex string for AES-256-GCM)
ENCRYPTION_KEY=

# Client & Domain URLs
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Razorpay Payment Gateway (Public Key ID & Private Secret)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public Frontend Razorpay Key ID (Safe for client-side bundle)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_API_URL=

# Transactional Email (SMTP / Gmail App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM="Zayna Abaya" <noreply@zaynaabaya.com>

# Monitoring (Optional)
SENTRY_DSN=
