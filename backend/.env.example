# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────
# Local development default:
MONGODB_URI=mongodb://localhost:27017/zayna_abaya
# Production MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/zayna_abaya?retryWrites=true&w=majority

# ── JWT Secrets ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_random_hex_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_different_random_hex_secret_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Client & CORS ─────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Symmetric Encryption ──────────────────────────────────────────────────
# 64 hex characters (32 bytes) for AES-256-GCM encryption of sensitive data
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Razorpay Integration ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# ── Email (SMTP / Nodemailer) ─────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=placeholder_smtp_user
SMTP_PASS=placeholder_smtp_password
EMAIL_FROM="Zayna Abaya" <noreply@zaynaabaya.com>

# ── Monitoring (Optional) ────────────────────────────────────────────────
# SENTRY_DSN=https://example@o0.ingest.sentry.io/0
